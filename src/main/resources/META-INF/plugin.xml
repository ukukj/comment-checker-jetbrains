<idea-plugin>
    <id>io.github.ukukj.commentchecker</id>
    <name>Comment Checker</name>
    <vendor url="https://github.com/ukukj">ukukj</vendor>
    <description><![CDATA[
    Review changed comments before commit.
    Adds a <b>Comments</b> tab to the Commit tool window. It lists the comments on changed lines of the files shown there
    (Changes and Unversioned Files), grouped by file, class and method.
    <ul>
      <li>Not just source code: build scripts, CI workflows and config files too
          (any file type with an installed language plugin).</li>
      <li>Marks added, modified and deleted comments. Deleted comments open in the diff.</li>
      <li>Filters by comment type: doc, line and block.</li>
      <li>UI in English and Korean, following the IDE language.</li>
    </ul>
    <b>Grouping by class and method</b>
    <ul>
      <li>Java, Kotlin, Python: dedicated rules (Python docstrings included).</li>
      <li>Other languages: from the editor breadcrumbs, verified on JavaScript, TypeScript and Go.</li>
    </ul>
    ]]></description>

    <resource-bundle>messages.CommentCheckerBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <!-- 언어 플러그인은 선택 의존. 없는 IDE(PyCharm 등)에서는 그 묶음만 로드하지 않음 -->
    <depends optional="true" config-file="commentchecker-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="commentchecker-kotlin.xml">org.jetbrains.kotlin</depends>
    <!-- 모듈 별칭(com.intellij.modules.python) 대신 플러그인 ID. IntelliJ 에 설치한 Python 플러그인과 PyCharm 모두 PythonCore -->
    <depends optional="true" config-file="commentchecker-python.xml">PythonCore</depends>

    <!-- Kotlin 플러그인은 이 선언을 메인 plugin.xml 에서만 봄. 선택 묶음에 두면 K2 모드에서 Kotlin 묶음이 통째로 꺼짐.
         Kotlin 이 없는 IDE 에서는 확장 지점이 없어 무시됨 -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensionPoints>
        <extensionPoint qualifiedName="io.github.ukukj.commentchecker.declarations"
                        beanClass="com.intellij.lang.LanguageExtensionPoint"
                        dynamic="true">
            <with attribute="implementationClass" implements="dev.commentchecker.core.Declarations"/>
        </extensionPoint>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <changesViewContent id="commentchecker.tab"
                            tabName="Comments"
                            className="dev.commentchecker.ui.CommentsTabProvider"
                            isInCommitToolWindow="true"/>
    </extensions>

    <actions>
        <action id="CommentChecker.Show"
                class="dev.commentchecker.ui.ShowChangedCommentsAction">
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
